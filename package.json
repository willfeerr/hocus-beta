{
  "name": "hocuspocus-coolify-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Hocuspocus v4 CLI service for Coolify with S3/MinIO, PostgreSQL, Redis, auth and health checks.",
  "type": "module",
  "bin": {
    "hocuspocus-coolify": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "health": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.3.0",
    "@hocuspocus/extension-logger": "4.3.0",
    "@hocuspocus/extension-redis": "4.3.0",
    "@hocuspocus/extension-s3": "4.3.0",
    "@hocuspocus/server": "4.3.0",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/pg": "8.20.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
