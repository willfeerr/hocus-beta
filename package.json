{
  "name": "hocuspocus-coolify-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Hocuspocus v4 CLI service for Coolify with S3/MinIO, PostgreSQL, Redis, auth and health checks.",
  "type": "module",
  "bin": {
    "hocuspocus-coolify": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "health": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.1.0",
    "@hocuspocus/extension-logger": "^4.2.0",
    "@hocuspocus/extension-redis": "^4.2.0",
    "@hocuspocus/extension-s3": "^4.1.0",
    "@hocuspocus/server": "^4.2.0",
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
