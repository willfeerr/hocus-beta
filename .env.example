NODE_ENV=development
PORT=1234
HOCUSPOCUS_NAME=skrbe-hocuspocus-local
LOG_LEVEL=debug

# Auth: none | static | webhook
AUTH_MODE=static
HOCUSPOCUS_TOKEN=dev-secret-change-me
# AUTH_ENDPOINT=https://app.example.com/api/hocuspocus/auth

# Allows dev only. Do not use true in production unless you know exactly why.
ALLOW_NO_AUTH_IN_PRODUCTION=false

# Room naming: page:{id}:v1, datasource:{id}:v1, database:{id}:v2, board:{id}:v1, etc.
ROOM_NAME_REGEX=^[a-zA-Z0-9:._-]{1,240}$

# Storage: s3 | postgres | memory
STORAGE_DRIVER=s3

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hocuspocus-documents
S3_REGION=us-east-1
S3_PREFIX=hocuspocus-documents/
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# PostgreSQL alternative
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/hocuspocus
POSTGRES_DOCUMENTS_TABLE=hocuspocus_documents

# Redis horizontal sync. Redis is not primary persistence.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

HOCUSPOCUS_TIMEOUT_MS=60000
HOCUSPOCUS_DEBOUNCE_MS=2000
HOCUSPOCUS_MAX_DEBOUNCE_MS=10000
HOCUSPOCUS_MAX_PAYLOAD_BYTES=10485760
